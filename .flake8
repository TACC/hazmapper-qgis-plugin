# .flake8
[flake8]
max-line-length = 100
extend-ignore = E203,W503
exclude =
    .git,
    .venv,
    __pycache__,
    build,
    dist,
    .eggs,
    .mypy_cache,
    .pytest_cache,
    Hazmapper/help/_build,
    Hazmapper/vendor/*
# Generated by scripts/designsafe_hazmapper_discovery.py; long project titles exceed the limit
per-file-ignores =
    Hazmapper/utils/maps_of_published_projects.py:E501
